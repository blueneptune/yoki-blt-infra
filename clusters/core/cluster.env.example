# The core cluster's addresses. Copy to cluster.env (not committed - it
# names real addresses) and fill in. Read by scripts/install-rke2-server.sh
# and scripts/kubeconfig.sh.

CLUSTER_NAME=core

# The spare IP kube-vip floats between the servers, and the network
# interface it lives on (the same name on all three, e.g. ens192).
VIP=192.168.50.200
VIP_INTERFACE=ens192

# Names and addresses the Kubernetes API certificate must cover, besides
# the VIP: each server's DNS name, and any name kubectl will use.
TLS_SANS="blt-core-01 blt-core-02 blt-core-03 k8s.blt.ecp.ensono.com"

# The first server, which the other two join.
FIRST_SERVER=blt-core-01

# RKE2 release channel ("stable"), or an exact version such as
# v1.33.5+rke2r1 once one has been chosen - pin it before production.
RKE2_CHANNEL=stable
# RKE2_VERSION=
